name: sequental jobs
on: workflow_dispatch

jobs:
  build-job:
    runs-on: ubuntu-latest
    steps:
      - name: checkout code
        uses: actions/checkout@v6
        
      - name: build steps
        run: echo "building application"

  test-job:
    runs-on: ubuntu-latest
    needs: build-job
    steps:
      - name: test step 
        run: echo "building test"

    deploy:
      runs-on: ubuntu-latest 
      needs: test-job
      steps: 
        - name: deploy step
          run: echo "deploy step"